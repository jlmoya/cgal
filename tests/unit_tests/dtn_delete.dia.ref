//checking what error will be produced with wrong types of inputs
x = [0.5878720    0.4829179    0.2232865    0.8400886    0.1205996];
y = [0.2855364    0.8607515    0.8494102    0.5257061    0.9931210];
z = [0.6488563    0.9923191    0.0500420    0.7485507    0.4104059];
points = [x' y' z'];
[tri,ptr] = delaunay_n(points);
assert_checkerror("dtn_delete(x)","%s: Wrong type for input argument #%d: A pointer expected.",999,"dtn_delete",1);
assert_checkerror("dtn_delete(ptr,x)","%s: Wrong type for input argument #%d: A scalar string expected.",999,"dtn_delete",2);
//checking what error will be produced with wrong number of inputs
assert_checkerror("dtn_delete(ptr,ptr,ptr)","%s: Wrong number of input argument(s): %d to %d expected.",77,"dtn_delete",0,2);
