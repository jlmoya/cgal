//checking if computed outputs are the same as expected
C=[1 1 5 1; 5 1 7 3; 7 3 4 4; 4 4 3 6; 3 6 1 5; 1 5 1 1;5 2 5 3; 5 3 3 4; 3 4 2 2; 2 2 5 2];
[coord,tri,ptr]= mesh_2(C);
mesh2_set_seeds(ptr,3.5,2.5);
tri = mesh2_get_connectivity(ptr);
coord = mesh2_get_coord(ptr);
coord1 = [1.       1.;5.       1.;7.       3.;4.       4.;3.       6.;1.       5.;5.       2.;5.       3.;3.       4.;2.       2.;6.       2.;3.       1.;3.5      5.;5.5      3.5;1.       3.;4.       3.5;5.5      1.5;3.5      2.;2.       1.;4.75     3.75;1.       2.;3.5      3.75;4.5      3.25;2.5      3.;3.375    2.875];
coord2 = [1.       1.;5.       1.;7.       3.;4.       4.;3.       6.;1.       5.;5.       2.;5.       3.;3.       4.;2.       2.;6.       2.;3.       1.;5.5     3.5;3.5      5;1.       3.;4.       3.5;5.5      1.5;3.5      2.;2.       1.;4.75     3.75;1.       2.;3.5      3.75;4.5      3.25;2.5      3.;3.375    2.875];
// A MESH is not unique: how many Steiner points CGAL inserts depends on its
// refinement criteria, which changed across versions. The pinned coordinate
// matrices recorded one particular refinement (25 vertices / 33 triangles); the
// current build produces a coarser but equally valid mesh (17 / 17). The test
// already carried TWO accepted orderings, so numbering was known to move even
// when it was written.
//
// What IS invariant, and what is asserted here, is the geometry:
//   * every input constraint vertex appears in the mesh
//   * no degenerate triangle
//   * indices in range, every vertex used
//   * the meshed area equals the domain exactly -- outer polygon 18.5 minus the
//     seeded hole 4.0 = 14.5 (shoelace on the constraints in C). That pins the
//     domain and the seed handling regardless of refinement density.
function checkmesh(coord, tri, C)
    T = double(tri);
    assert_checktrue(min(T) >= 1 & max(T) <= size(coord,"r"));
    assert_checkequal(size(unique(T(:)),"*"), size(coord,"r"));
    B = [C(:,1:2); C(:,3:4)];
    for i = 1:size(B,"r")
        assert_checktrue(min(sqrt((coord(:,1)-B(i,1)).^2 + (coord(:,2)-B(i,2)).^2)) < 1e-9);
    end
    ar = 0;
    for k = 1:size(T,"r")
        p = coord(T(k,:),:);
        a = abs((p(2,1)-p(1,1))*(p(3,2)-p(1,2)) - (p(3,1)-p(1,1))*(p(2,2)-p(1,2)))/2;
        assert_checktrue(a > 1e-12);
        ar = ar + a;
    end
    assert_checkalmostequal(ar, 14.5, 1e-9);
endfunction
checkmesh(coord, mesh2_get_connectivity(ptr), C);
//checking what error will be produced with wrong number of inputs
assert_checkerror("tri=mesh2_get_coord(ptr,ptr)","%s: Wrong number of input argument(s): %d expected.",77,"mesh2_get_coord",1);
//checking what error will be produced with wrong types of inputs
assert_checkerror("tri=mesh2_get_coord(C)","%s: Wrong type for input argument #%d: A pointer expected.",999,"mesh2_get_coord",1);
