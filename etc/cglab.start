function cglablib = startModule()

  mprintf("Start CG-lab\n");

  if isdef("cglablib") then
    warning("CG-lab library is already loaded");
    return;
  end

  etc_tlbx  = get_absolute_file_path("cglab.start");
  etc_tlbx  = getshortpathname(etc_tlbx);
  root_tlbx = strncpy( etc_tlbx, length(etc_tlbx)-length("\etc\") );
 
  // Load macros library
  // =============================================================================
  mprintf("\tLoad macros\n");
  pathmacros = fullfile(root_tlbx, "macros");
  cglablib = lib(pathmacros);
  
  // Load thirdparties
  // =============================================================================
  verboseMode = ilib_verbose();
  ilib_verbose(0);

  mprintf("\tLoad thirdparties\n");
  [version, opts] = getversion();
  arch = opts(2);
  if getos() == "Windows" then
      bin_path = fullfile(root_tlbx, "thirdparty", "Windows", arch, "bin");
      orig_dir = pwd();
      cd(bin_path);
      link(fullfile(bin_path, "boost_system-vc120-mt-1_60.dll"));
      link(fullfile(bin_path, "boost_chrono-vc120-mt-1_60.dll"));
      link(fullfile(bin_path, "boost_thread-vc120-mt-1_60.dll"));
      link(fullfile(bin_path, "CGAL-vc120-mt-4.7.dll"));
      link(fullfile(bin_path, "CGAL_ImageIO-vc120-mt-4.7.dll"));
      cd(orig_dir);
  elseif getos() == "Linux"
      lib_path = fullfile(root_tlbx, "thirdparty", "Linux", arch, "lib");
      link(fullfile(lib_path, "libgmp.so.10"));
      link(fullfile(lib_path, "libmpfr.so.4"));
      link(fullfile(lib_path, "libboost_system-mt.so.5"));
      link(fullfile(lib_path, "libboost_thread-mt.so.5"));
      link(fullfile(lib_path, "libCGAL.so"));     
      link(fullfile(lib_path, "libCGAL_ImageIO.so"));         
  elseif getos() == "Darwin"
      lib_path = fullfile(root_tlbx, "thirdparty", "Darwin", arch, "lib");
      link(fullfile(lib_path, "libgmp.dylib"));
      link(fullfile(lib_path, "libmpfr.dylib"));
      link(fullfile(lib_path, "libboost_system-mt.dylib"));
      link(fullfile(lib_path, "libboost_thread-mt.dylib"));
      link(fullfile(lib_path, "libCGAL.dylib"));     
      link(fullfile(lib_path, "libCGAL_ImageIO.dylib"));         
  end

  // Load gateways
  // =============================================================================
  mprintf("\tLoad gateways\n");
  exec(fullfile(root_tlbx, "sci_gateway", "loader_gateway.sce"));

  // Load help chapter
  // =============================================================================
  if or(getscilabmode() == ["NW";"STD"]) then
    mprintf("\tLoad help\n");
    path_addchapter = fullfile(root_tlbx, "jar");
    if (isdir(path_addchapter) <> []) then
      add_help_chapter("CG-lab", path_addchapter, %F);
    end
  end

  // Load demos
  // =============================================================================
  if or(getscilabmode() == ["NW";"STD"]) then
    mprintf("\tLoad demos\n");
    add_demo("CG-lab", fullfile(root_tlbx, "demos", "cglab.dem.gateway.sce"));
  end

endfunction

cglablib = startModule();
clear startModule;
