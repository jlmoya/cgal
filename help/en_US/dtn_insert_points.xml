<refentry xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="http://www.w3.org/2000/svg" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:db="http://docbook.org/ns/docbook" version="5.0-subset Scilab" xml:lang="en" xml:id="dtn_insert_points"><info><pubdate>November 2005</pubdate></info><refnamediv><refname>dtn_insert_points</refname><refpurpose> Insert new points in dtn.</refpurpose></refnamediv>
	
   
	
   
	
   
	
   
	
   
	
   <refsynopsisdiv><title>Calling Sequence</title><synopsis>dtn_insert_points(ptr,new_points);</synopsis></refsynopsisdiv>
	
   <refsection><title>Parameters</title>
		
      <variablelist>
			
         <varlistentry>
				
            <term>new_points</term>
				
            <listitem>
					: is an (m,n) array representing m new points in n-D space.
				</listitem>
			
         </varlistentry>
			
         <varlistentry>
				
            <term>ptr</term>
				
            <listitem>
					: is a pointer representing dtn.
				</listitem>
			
         </varlistentry>
		
      </variablelist>
	
   </refsection>
	
   <refsection><title>Description</title>
		
      <para>
			Given a pointer ptr of dtn, dtn_insert_points(ptr,new_points) inserts a new points in dtn.
		</para>
	
   </refsection>
	
   <refsection><title>Examples</title><programlisting role="example"><![CDATA[
		

x = rand(1,5);
y = rand(1,5);
z = rand(1,5);
points = [x' y' z'];
[tri,ptr] = delaunay_n(points);
tri
new_x = rand(1,2);
new_y = rand(1,2);
new_z = rand(1,2);
new_points = [new_x' new_y' new_z'];
dtn_insert_points(ptr,new_points);
new_tri = dtn_get_connectivity(ptr)
dtn_delete(ptr,"ptr");

						 
	]]></programlisting></refsection>
	
