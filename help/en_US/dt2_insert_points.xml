<refentry xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="http://www.w3.org/2000/svg" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:db="http://docbook.org/ns/docbook" version="5.0-subset Scilab" xml:lang="en" xml:id="dt2_insert_points"><info><pubdate>November 2005</pubdate></info><refnamediv><refname>dt2_insert_points</refname><refpurpose> Insert new points in dt2.</refpurpose></refnamediv>
  
   
  
   
  
   
  
   
  
   
  
   <refsynopsisdiv><title>Calling Sequence</title><synopsis>dt2_insert_points(ptr,new_x,new_y);</synopsis></refsynopsisdiv>
  
   <refsection><title>Parameters</title>
  
      <variablelist>
    
         <varlistentry>
      
            <term>new_x,new_y</term>
      
            <listitem>
        : are vectors of new points coordinates.
      </listitem>
    
         </varlistentry>
        
         <varlistentry>
            
            <term>ptr</term>
            
            <listitem>
                : is a pointer representing dt2.
            </listitem>
    
         </varlistentry>
  
      </variablelist>
  
   </refsection>
  
   <refsection><title>Description</title>
  
      <para>
  Given a pointer ptr of dt2, dt2_insert_points(ptr,new_x,new_y) inserts a new points in dt2.
  </para>  
  
   </refsection>
  
   <refsection><title>Examples</title><programlisting role="example"><![CDATA[


x = rand(1,10);
y = rand(1,10);
[tri1,ptr] = delaunay_2(x,y);

[nbtri,nb] = size(tri1);
tri = [tri1 tri1(:,1)];
clf();
for k = 1:nbtri
plot2d(x(tri(k,:)),y(tri(k,:)),style = 2);
end   
new_x = rand(1,10);
new_y = rand(1,10);  
dt2_insert_points(ptr,new_x,new_y);
new_tri = dt2_get_connectivity(ptr);

[nbtri,nb] = size(new_tri);
tri = [new_tri new_tri(:,1)];
clf();
X=[x new_x];
Y=[y new_y];
for k = 1:nbtri
plot2d(X(tri(k,:)),Y(tri(k,:)),style = 2);
end 
dt2_delete(ptr,"ptr");

 
  ]]></programlisting></refsection>
  
