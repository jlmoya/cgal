function cglablib = startModule()

  mprintf("Start CG-lab: ");

  if isdef("cglablib") then
    warning("CG-lab library is already loaded");
    return;
  end

  etc_tlbx  = get_absolute_file_path("cglab.start");
  etc_tlbx  = getshortpathname(etc_tlbx);
  root_tlbx = strncpy( etc_tlbx, length(etc_tlbx)-length("\etc\") );

  // Load macros library
  // =============================================================================
  mprintf("load macros");
  pathmacros = fullfile(root_tlbx, "macros");
  cglablib = lib(pathmacros);

  // Load thirdparties
  // =============================================================================
  verboseMode = ilib_verbose();
  ilib_verbose(0);

  mprintf(", thirdparties");
  [version, opts] = getversion();
  arch = opts(2);
  if getos() == "Windows" then
      bin_path = fullfile(root_tlbx, "thirdparty", "Windows", arch, "bin");
      orig_dir = pwd();
      cd(bin_path);
      link("libgmp-10.dll");
      if (isDebug())
        link("boost_thread-vc143-mt-gd-x64-1_86.dll");
        link("CGAL-vc140-mt-gd-4.7.dll");
        link("CGAL_ImageIO-vc140-mt-gd-4.7.dll");
        link("CGAL_Core-vc140-mt-gd-4.7.dll");
      else
        link("boost_thread-vc143-mt-x64-1_86.dll");
        link("CGAL-vc140-mt-4.7.dll");
        link("CGAL_ImageIO-vc140-mt-4.7.dll");
        link("CGAL_Core-vc140-mt-4.7.dll");
      end
      cd(orig_dir);
  elseif getos() == "Linux"
      lib_path = fullfile(root_tlbx, "thirdparty", "Linux", arch, "lib");
      link(fullfile(lib_path, "libgmp.so"));
      link(fullfile(lib_path, "libboost_thread.so"));
      link(fullfile(lib_path, "libCGAL.so"));
      link(fullfile(lib_path, "libCGAL_ImageIO.so"));
      link(fullfile(lib_path, "libCGAL_Core.so"));
  elseif getos() == "Darwin"
      // macOS arm64: no bundled thirdparty. gmp + mpfr resolve through libcgal_cpp's
      // embedded rpath (/opt/homebrew/opt/{gmp,mpfr}/lib); CGAL 6 is header-only so it
      // is compiled into libcgal_cpp and needs no runtime link. Nothing to link here.
  end

  // Load gateways
  // =============================================================================
  mprintf(", gateways");
  exec(fullfile(root_tlbx, "sci_gateway", "loader_gateway.sce"));

  // Load help chapter
  // =============================================================================
  if or(getscilabmode() == ["NW";"STD"]) then
    mprintf(", help");
    path_addchapter = fullfile(root_tlbx, "jar");
    if (isdir(path_addchapter) <> []) then
      add_help_chapter("CG-lab", path_addchapter, %F);
    end
  end

  // Load demos
  // =============================================================================
  if or(getscilabmode() == ["NW";"STD"]) then
    mprintf(", demos.\n");
    add_demo("CG-lab", fullfile(root_tlbx, "demos", "cglab.dem.gateway.sce"));
  end

endfunction

cglablib = startModule();
clear startModule;
