//checking what error will be produced with wrong types of inputs
x = [5 1 6];
y = [2 6 6];
C=[8.    2.     7.    4.;6.    4.5    4.    5.;3.    6.     3.    7.;3.    4.     2.    3.;9.    4.     8.    7.];
[tri,ptr] = constrained_delaunay_2([],[],C);
cdt2_insert_points(ptr,x,y);
tri = cdt2_get_connectivity(ptr);
type1=type(tri);
if type1<>8 then bugmes();quit;end;
assert_checkerror("new_tri=cdt2_get_connectivity()","%s: Wrong number of input argument(s): %d expected.",77,"cdt2_get_connectivity",1);
assert_checkerror("new_tri=cdt2_get_connectivity(ptr,ptr)","%s: Wrong number of input argument(s): %d expected.",77,"cdt2_get_connectivity",1);
//checking what error will be produced with wrong number of inputs
assert_checkerror("new_tri=cdt2_get_connectivity(x)","%s: Wrong type for input argument #%d: A pointer expected.",999,"cdt2_get_connectivity",1);
